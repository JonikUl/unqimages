{
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": true,
  "trailingComma": "all",
  "endOfLine": "lf",
  "insertFinalNewline": true,
  "ignorePatterns": [
    "node_modules/**",
    "dist/**",
    "target/**",
    "*.backup",
    "platform-packages/**",
    ".github/**/*.yml"
  ]
}
