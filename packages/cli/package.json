{
  "name": "@unqimages/cli",
  "version": "0.1.0",
  "description": "CLI for finding duplicate images",
  "type": "module",
  "bin": {
    "unqimages": "./bin/unqimages.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["bin", "dist"],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b"
  },
  "optionalDependencies": {
    "@unqimages/cli-darwin-arm64": "0.1.0",
    "@unqimages/cli-darwin-x64": "0.1.0",
    "@unqimages/cli-linux-x64": "0.1.0",
    "@unqimages/cli-windows-x64": "0.1.0"
  },
  "peerDependencies": {
    "husky": ">=8.0.0",
    "lint-staged": ">=10.0.0"
  },
  "peerDependenciesMeta": {
    "husky": {
      "optional": true
    },
    "lint-staged": {
      "optional": true
    }
  },
  "devDependencies": {
    "@unqimages/config": "workspace:*",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}
